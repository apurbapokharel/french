{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unit.schema.json",
  "title": "Units",
  "type": "array",
  "items": { "$ref": "#/definitions/Unit" },
  "definitions": {
    "Unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "title", "outsidePractice"],
      "properties": {
        "unit": { "type": "integer", "minimum": 1, "maximum": 8 },
        "title": { "type": "string", "minLength": 1 },
        "outsidePractice": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
